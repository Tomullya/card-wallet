{
  "info": {
    "name": "Card Wallet API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mini Card Wallet — demo fintech API (local). Run top to bottom: every request saves what the next one needs (token, account, card, CVV). All data is fictional."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Passw0rd1"
    },
    {
      "key": "account_id",
      "value": ""
    },
    {
      "key": "card_id",
      "value": ""
    },
    {
      "key": "card_cvv",
      "value": ""
    },
    {
      "key": "wrong_cvv",
      "value": ""
    },
    {
      "key": "idem_key",
      "value": ""
    },
    {
      "key": "first_tx",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('all services ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"name\": \"Anna Tester\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `user-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('password not returned', () => pm.expect(pm.response.json()).to.not.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().access_token;",
                  "pm.collectionVariables.set('token', token);",
                  "if (pm.environment.name) { pm.environment.set('token', token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — wrong password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wrong1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('same error for unknown e-mail and wrong password', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/me",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Accounts",
      "item": [
        {
          "name": "Open EUR account",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/accounts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"EUR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('new account has zero balance', () => pm.expect(pm.response.json().balance).to.eql('0.00'));",
                  "pm.collectionVariables.set('account_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Open second EUR account → 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/accounts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"EUR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('ACCOUNT_ALREADY_EXISTS', () => pm.expect(pm.response.json().error.code).to.eql('ACCOUNT_ALREADY_EXISTS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('one account', () => pm.expect(pm.response.json()).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Top up 100.00",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/accounts/{{account_id}}/top-up",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"100.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('balance 100.00', () => pm.expect(pm.response.json().balance).to.eql('100.00'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Top up 10000.01 → 422",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/accounts/{{account_id}}/top-up",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"10000.01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Cards",
      "item": [
        {
          "name": "Issue card",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/accounts/{{account_id}}/cards",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_limit\": \"500.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const card = pm.response.json();",
                  "pm.test('PAN uses the fake 400000 prefix', () => pm.expect(card.pan).to.match(/^400000\\d{10}$/));",
                  "pm.collectionVariables.set('card_id', card.id);",
                  "pm.collectionVariables.set('card_cvv', card.cvv);",
                  "pm.collectionVariables.set('wrong_cvv', String((parseInt(card.cvv, 10) + 1) % 1000).padStart(3, '0'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get card (masked)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/cards/{{card_id}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('PAN masked, no CVV', () => {",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.masked_pan).to.match(/^\\*{4} \\*{4} \\*{4} \\d{4}$/);",
                  "  pm.expect(c).to.not.have.property('cvv');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List cards",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/{{account_id}}/cards",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Payments",
      "item": [
        {
          "name": "Pay 10.00 (approved, min commission)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{card_cvv}}\",\n  \"amount\": \"10.00\",\n  \"merchant_name\": \"Coffee Shop\",\n  \"merchant_category\": \"RESTAURANTS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('approved with commission 0.50', () => {",
                  "  const p = pm.response.json();",
                  "  pm.expect(p.status).to.eql('APPROVED');",
                  "  pm.expect(p.commission).to.eql('0.50');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Gambling merchant → fraud decline",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{card_cvv}}\",\n  \"amount\": \"10.00\",\n  \"merchant_name\": \"Lucky Casino\",\n  \"merchant_category\": \"GAMBLING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('FRAUD_BLOCKED_CATEGORY', () => pm.expect(pm.response.json().decline_reason).to.eql('FRAUD_BLOCKED_CATEGORY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fraud service timeout → 503",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{card_cvv}}\",\n  \"amount\": \"10.00\",\n  \"merchant_name\": \"TEST_TIMEOUT\",\n  \"merchant_category\": \"OTHER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 503', () => pm.response.to.have.status(503));",
                  "pm.test('FRAUD_SERVICE_UNAVAILABLE', () => pm.expect(pm.response.json().error.code).to.eql('FRAUD_SERVICE_UNAVAILABLE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotency — first request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{card_cvv}}\",\n  \"amount\": \"5.00\",\n  \"merchant_name\": \"Book Store\",\n  \"merchant_category\": \"OTHER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('first_tx', pm.response.json().transaction_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotency — same key again (no double charge)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{card_cvv}}\",\n  \"amount\": \"5.00\",\n  \"merchant_name\": \"Book Store\",\n  \"merchant_category\": \"OTHER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('same transaction returned', () => pm.expect(pm.response.json().transaction_id).to.eql(pm.collectionVariables.get('first_tx')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotency — same key, other amount → 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{card_cvv}}\",\n  \"amount\": \"6.00\",\n  \"merchant_name\": \"Book Store\",\n  \"merchant_category\": \"OTHER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('IDEMPOTENCY_KEY_REUSED', () => pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REUSED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Balance after payments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/{{account_id}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('100 - 10.50 - 5.50 = 84.00', () => pm.expect(pm.response.json().balance).to.eql('84.00'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong CVV attempt 1",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{wrong_cvv}}\",\n  \"amount\": \"1.00\",\n  \"merchant_name\": \"Shop\",\n  \"merchant_category\": \"GROCERIES\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('INVALID_CVV', () => pm.expect(pm.response.json().decline_reason).to.eql('INVALID_CVV'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong CVV attempt 2",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{wrong_cvv}}\",\n  \"amount\": \"1.00\",\n  \"merchant_name\": \"Shop\",\n  \"merchant_category\": \"GROCERIES\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('INVALID_CVV', () => pm.expect(pm.response.json().decline_reason).to.eql('INVALID_CVV'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong CVV attempt 3",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"cvv\": \"{{wrong_cvv}}\",\n  \"amount\": \"1.00\",\n  \"merchant_name\": \"Shop\",\n  \"merchant_category\": \"GROCERIES\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('INVALID_CVV', () => pm.expect(pm.response.json().decline_reason).to.eql('INVALID_CVV'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Card is blocked after 3 wrong CVV",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/cards/{{card_id}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('BLOCKED / TOO_MANY_FAILED_ATTEMPTS', () => {",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.status).to.eql('BLOCKED');",
                  "  pm.expect(c.block_reason).to.eql('TOO_MANY_FAILED_ATTEMPTS');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Statement",
      "item": [
        {
          "name": "Statement — all",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/{{account_id}}/transactions?limit=20&offset=0",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('newest first', () => {",
                  "  const items = pm.response.json().items;",
                  "  pm.expect(items[items.length - 1].type).to.eql('TOP_UP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Statement — declined only",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/{{account_id}}/transactions?status=DECLINED",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only declined', () => pm.response.json().items.forEach(i => pm.expect(i.status).to.eql('DECLINED')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Cleanup",
      "item": [
        {
          "name": "Block card → already blocked (409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/cards/{{card_id}}/block",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('CARD_ALREADY_BLOCKED', () => pm.expect(pm.response.json().error.code).to.eql('CARD_ALREADY_BLOCKED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
